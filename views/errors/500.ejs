<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <title>Error del servidor | Conecta Alimentos</title>
</head>
<body>
  <%- include('../layout/header', { title: 'Error del servidor' }) %>

  <main class="container">
    <div class="error-ticket">
      <div class="code" style="color:var(--brasa);">500</div>
      <h1 class="page-title">Algo se echó a perder</h1>
      <p class="muted"><%= typeof message !== 'undefined' ? message : 'Ocurrió un problema inesperado. Intenta nuevamente más tarde.' %></p>
      <a class="btn" href="/" style="margin-top:20px;">Volver al inicio</a>
    </div>
  </main>

  <%- include('../layout/footer') %>
</body>
</html>

<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <title>Panel Admin | Conecta Alimentos</title>
</head>
<body>

  <%- include('../layout/header', { title: 'Panel Admin' }) %>

  <nav class="breadcrumb container">
    <a href="/">Inicio</a> / <span>Panel admin</span>
  </nav>

  <main class="container section">
    <span class="eyebrow">Administración</span>
    <h1 class="page-title">Panel de administración</h1>
    <p class="page-subtitle">Elige qué quieres revisar.</p>

    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:20px; margin-top:24px;">

      <div class="card" style="padding:26px;">
        <span class="eyebrow">Seguridad</span>
        <h2 class="page-title" style="font-size:26px;">Auditoría</h2>
        <p class="muted" style="margin:8px 0 20px;">
          Registro de eventos: logins, registros, cierres de sesión, ofertas y reservas.
        </p>
        <a class="btn" href="/admin/auditoria">Ver auditoría</a>
      </div>

      <div class="card" style="padding:26px;">
        <span class="eyebrow">Reportes</span>
        <h2 class="page-title" style="font-size:26px;">Estadísticas</h2>
        <p class="muted" style="margin:8px 0 20px;">
          Impacto de la plataforma y resumen de usuarios, ofertas y reservas.
        </p>
        <a class="btn" href="/admin/estadisticas">Ver estadísticas</a>
      </div>

    </div>
  </main>

  <%- include('../layout/footer') %>

</body>
</html>
